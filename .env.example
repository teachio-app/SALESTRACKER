# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # server-only, never expose to client

# Zoho IMAP (use an app-specific password, not your login password)
IMAP_HOST=imappro.zoho.eu
IMAP_PORT=993
IMAP_USER=petr.pech@thevortex.beauty
IMAP_PASSWORD=your-zoho-app-password

# Discord (notification only)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
DISCORD_PAYMENT_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/zzz   # payout pings
# Numeric Discord user ID to @mention on every alert (NOT a username).
# Get it: Discord → Settings → Advanced → Developer Mode, then right-click your
# name → Copy User ID.
DISCORD_MENTION_USER_ID=123456789012345678

# Seatix alert module (/api/cron/seatix-alert) — standalone, no UI, no DB rows.
# Its own webhook so the pings land in their own channel, apart from everything
# above. Leave SEATIX_WEBHOOK_URL empty and the module is simply off (it returns
# 503 and reads no mail).
SEATIX_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/www
# Numeric ROLE id to tag on each alert — Server Settings → Roles → right-click
# the role → Copy Role ID (needs Developer Mode). A role, not a user: the module
# mentions it as <@&id>. Omit it and alerts go out without a ping.
SEATIX_ROLE_ID=987654321098765432

# Pushover → Discord bridge (/api/cron/pushover-bridge) — standalone, no UI.
# Relays notifications that other apps push at your Pushover account.
# SECRET and DEVICE_ID come from a one-time `?setup=1` call; the account
# password is used there and never stored. Note: Pushover requires a Pushover
# for Desktop licence within 30 days of activating an Open Client device.
PUSHOVER_SECRET=
PUSHOVER_DEVICE_ID=
# Where the relayed notifications go. Falls back to DISCORD_WEBHOOK_URL if empty.
PUSHOVER_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/vvv
PUSHOVER_ROLE_ID=            # optional numeric ROLE id to ping, mentioned as <@&id>
# Only needed to mint group keys (?group=<name>) — one key per source app, used
# in place of your user key. Token from pushover.net → Your Applications.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=           # your own user key, so new groups still deliver to you

# Dashboard login (HTTP Basic Auth — gates the dashboard + /api/tickets)
APP_USER=admin
APP_PASSWORD=pick-something

# Cron protection — Vercel auto-sends this as a Bearer header on cron runs;
# the external pinger must send the same. Does NOT gate the human login.
CRON_SECRET=some-long-random-string
